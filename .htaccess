# グローバルプロジェクト LP / Apache 設定
# お名前.com など Apache 系サーバーへの設置を想定。
# ※ HTTPSリダイレクトはサーバー側の設定と衝突しうるのでここには書かない。

# --- 圧縮 --------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- キャッシュ ---------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # フォント・画像・動画は内容が変わったらファイル名を変える運用（?v= 付与）
  ExpiresByType font/woff2        "access plus 1 year"
  ExpiresByType image/webp        "access plus 1 year"
  ExpiresByType image/png         "access plus 1 year"
  ExpiresByType image/svg+xml     "access plus 1 year"
  ExpiresByType video/mp4         "access plus 1 year"
  ExpiresByType text/css          "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/html         "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|png|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# --- MIME --------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType video/mp4  .mp4
</IfModule>

# --- 配信不要ファイルの遮断 ---------------------------------
# fonts/_full/ はサブセット化の元データ。ページからは参照しない。
RedirectMatch 404 ^/.*/fonts/_full/
<FilesMatch "\.(py|md)$">
  Require all denied
</FilesMatch>
